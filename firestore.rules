rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == userId
        && incoming().email is string
        && incoming().email.size() > 0;
      allow delete: if isOwner(userId);

      // User's Saved Services subcollection
      match /savedServices/{savedId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(savedId)
          && incoming().userId == userId
          && incoming().serviceId is string;
        allow delete: if isOwner(userId);
      }
    }

    // Service Feedbacks collection
    match /serviceFeedbacks/{feedbackId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(feedbackId)
        && incoming().userId == request.auth.uid
        && incoming().rating is number
        && incoming().rating >= 1
        && incoming().rating <= 5
        && (incoming().comment == null || (incoming().comment is string && incoming().comment.size() <= 1000));
      allow update, delete: if isSignedIn()
        && existing().userId == request.auth.uid;
    }
  }
}
